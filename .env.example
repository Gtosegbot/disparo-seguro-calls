# WACALLS CONFIGURATION TEMPLATE (.env)

# API Master Key
WACALLS_API_KEY=admin-master-key

# Database Connection (SQLite fallback: /data/wacalls.db)
# DATABASE_URL=postgres://postgres:postgres@db:5432/wacalls?sslmode=disable

# Redis Connection URL
# REDIS_URL=redis://redis:6379/0

# Provedores de Voz (AI Realtime API Keys)
WACALLS_XAI_KEY=
WACALLS_GEMINI_KEY=

# Integração ChatSeguro (Chatwoot API)
CHATSEGURO_URL=
CHATSEGURO_TOKEN=

# Proxy de saída global residencial
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=
